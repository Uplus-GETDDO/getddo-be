DB_NAME=getddo
DB_USERNAME=getddo
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 쉼표로 구분한 프론트 origin 목록. 미설정 시 다른 origin의 요청을 허용하지 않습니다.
# origin에는 프로토콜·호스트·포트만 넣고 API 경로는 넣지 않습니다. wildcard(*)는 금지합니다.
# Compose 실행 전 이 파일을 .env로 복사합니다. bootRun/IDE 실행은 환경변수를 따로 설정합니다.
CORS_ALLOWED_ORIGINS=

# CloudWatch 앱 지표는 로컬/테스트에서 기본 비활성화. 활성화 시 서버 a 또는 c와 리전을 명시합니다.
GETDDO_METRICS_ENABLED=false
GETDDO_METRICS_SERVER=
AWS_REGION=ap-northeast-2
GETDDO_METRICS_ENVIRONMENT=dev
GETDDO_METRICS_NAMESPACE=GETDDO/API
GETDDO_METRICS_STEP=60s

# CloudWatch 앱 지표용 배포 env 조각입니다. 기존 필수 DB·Redis·이미지 설정에 추가합니다.
# 이 파일만으로 전체 앱을 배포할 수 없습니다. 실제 app.env는 기존 비밀값 조회 경로를 유지합니다.
GETDDO_METRICS_ENABLED=true
GETDDO_METRICS_ENVIRONMENT=dev
GETDDO_METRICS_NAMESPACE=GETDDO/API
GETDDO_METRICS_STEP=60s
AWS_REGION=ap-northeast-2
# A에서는 a, C에서는 c. 공유 Parameter Store 값으로 서버 식별자를 덮어쓰지 않습니다.
GETDDO_METRICS_SERVER=a

// GETDDO 최신 ERD 설계 초안 — 2026-10-07 사용자 최종 SQL과 기존 DBML 제약 대조.
// 45개 테이블. 초기 44개는 GD-93의 V001~V011, 공개 실행 연결은 GD-169의 V024에 반영. 실제 DB 적용·서비스 호환성은 별도 검증 필요.
// 이 DBML은 초기 스키마(V001~V011)에 공개 실행 연결(V024)을 추가한 기준이다. 이후 마이그레이션이 추가한 인덱스·컬럼(예: 이벤트 목록·응모권 차감·만료 인덱스)은 마이그레이션이 기준이며 여기에 모두 반영하지 않았다.
// UNIQUE는 indexes, FK는 Ref, CHECK는 checks 블록에 명시. MySQL 생성식은 주석에 기록.
// 티켓·추첨 근거 제약 및 서비스 검증 계약을 반영한 최신 설계.
// 시각 UTC, 업무 날짜·월 KST. 회수 기능은 2026-10-07 사용자 확정에 따라 이번 버전에서 제외. 공용 spec의 scope.md·ticket.md와 일치.

Enum missions_mission_type_enum {
  SURVEY
  QUIZ
}

Enum missions_status_enum {
  ACTIVE
  ENDED
}

Enum users_role_enum {
  USER
  ADMIN
}

Enum users_status_enum {
  ACTIVE
  INACTIVE
}

Enum users_membership_enum {
  EXCELLENT
  VIP
  VVIP
}

Enum reward_policies_reward_type_enum {
  ATTENDANCE
  MISSION
  GAME
}

Enum reward_policies_reward_ticket_type_enum {
  PLATINUM
  GOLD
  SILVER
  BRONZE
}

Enum notifications_mock_delivery_status_enum {
  PENDING
  SENT
  FAILED
}

Enum mission_quiz_questions_question_type_enum {
  OX
  SINGLE_CHOICE
  SHORT_ANSWER
}

Enum survey_questions_question_type_enum {
  SINGLE_CHOICE
  FREE_TEXT
}

Enum attendance_reward_claims_reward_type_enum {
  DAILY
  STREAK
}

Enum notification_jobs_notification_type_enum {
  EVENT_START
  RESULT_PUBLISHED
  ENTRY_EXCLUDED
  EVENT_SCHEDULE_CHANGED
  EVENT_CANCELED
  RESULT_CHANGED
}

Enum notification_jobs_status_enum {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

Enum draw_results_result_type_enum {
  SELECTED
  UNFILLED
}

Enum draw_runs_draw_type_enum {
  INITIAL
  REPLACEMENT
}

Enum draw_runs_status_enum {
  PREPARING
  READY
  RUNNING
  CONFIRMED
  FAILED
  NO_ENTRIES
  NO_CANDIDATES
}

Enum draw_publications_publication_type_enum {
  INITIAL
  UPDATE
}

Enum events_event_type_enum {
  NO_TICKET
  TICKET
}

Enum events_status_enum {
  SCHEDULED
  OPEN
  CLOSED
  DRAW_CONFIRMED
  PUBLISHED
  CANCELED
  REDRAWING
  NO_ENTRANTS
  // 기존 DB 스키마의 상태. 신규 이벤트에는 사용하지 않으며 공개 조회 계약은 별도 검토한다.
  NO_ELIGIBLE_ENTRANTS
}

Enum events_membership_rule_enum {
  excellent
  vip
  vvip
}

Enum game_log_batches_storage_status_enum {
  PENDING
  STORED
  FAILED
}

Enum game_play_analyses_status_enum {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

Enum game_play_analyses_data_completeness_enum {
  UNKNOWN
  PARTIAL
  COMPLETE
}

Enum game_play_analyses_verdict_enum {
  NORMAL
  ABUSE
}

Enum tickets_grade_enum {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

Enum tickets_status_enum {
  AVAILABLE
  RETURNED
  SPENT
  EXPIRED
}

Enum ticket_histories_operation_type_enum {
  GRANT
  USE
  REFUND
  EXPIRE
  CORRECTION
}

Enum ticket_histories_status_enum {
  AVAILABLE
  RETURNED
  SPENT
  EXPIRED
}

Table game_plays {
  id binary(16) [pk, not null, note: '게임 플레이 ID']
  game_id binary(16) [not null, note: '게임 ID']
  user_id binary(16) [not null, note: '사용자 ID']
  rule_version varchar(30) [not null, note: '적용 게임 규칙 버전']
  rules_snapshot json [note: '시작 시점 공개 규칙 원본. 과거 행은 검증 기준 네 컬럼 모두 NULL']
  play_token_hash varchar(64) [note: '서버 발급 플레이 토큰 SHA-256']
  generator_version varchar(50) [note: '문제 생성 알고리즘 버전']
  generation_seed bigint [note: '0이 아닌 unsigned 32-bit 문제 생성값']
  score bigint [note: '서버가 판정한 게임 점수']
  result_hash varchar(64) [note: '같은 플레이에 다른 결과 제출을 방지하는 해시']
  created_at datetime(6) [not null, note: '플레이 시작·행 생성 시각 UTC']
  completed_at datetime(6) [note: '완료 시각 UTC']

  indexes {
    (id, user_id, game_id) [unique, name: 'uq_game_plays_1']
  }

  checks {
    `(rules_snapshot IS NULL AND play_token_hash IS NULL AND generator_version IS NULL AND generation_seed IS NULL) OR (rules_snapshot IS NOT NULL AND JSON_TYPE(rules_snapshot) = 'OBJECT' AND play_token_hash IS NOT NULL AND CHAR_LENGTH(play_token_hash) = 64 AND generator_version IS NOT NULL AND CHAR_LENGTH(generator_version) > 0 AND generation_seed IS NOT NULL AND generation_seed BETWEEN 1 AND 4294967295)` [name: 'chk_game_play_context']
    `rules_snapshot IS NULL OR (completed_at IS NULL AND score IS NULL AND result_hash IS NULL) OR (completed_at IS NOT NULL AND completed_at >= created_at AND result_hash IS NOT NULL AND CHAR_LENGTH(result_hash) = 64 AND (score IS NULL OR score >= 0))` [name: 'chk_game_play_result']
  }

  Note: '검증 기준이 있는 신규 행: completed_at NULL=미완료, 완료 시 score NOT NULL=VALID(0점 포함), score NULL=INVALID. 같은 result_hash는 최초 결과 유지. PROCESSING은 영속 상태가 아닌 API 처리 중 응답이며 후속 구현.'
}

Table attendances {
  id binary(16) [pk, not null, note: '출석 ID']
  user_id binary(16) [not null, note: '사용자 ID']
  attendance_date date [not null, note: '출석 기준 날짜 KST']
  created_at datetime(6) [not null, note: '생성 시각 UTC']

  indexes {
    (user_id, attendance_date) [unique, name: 'uq_attendances_1']
  }
}

Table user_game_stats {
  id binary(16) [pk, not null, note: '식별자(UUID)']
  user_id binary(16) [not null, note: '사용자 ID']
  game_id binary(16) [not null, note: '게임 ID']
  best_score bigint [not null, default: 0, note: '개인 최고 점수']
  total_score bigint [not null, default: 0, note: '유효 플레이 누적 점수']
  valid_play_count bigint [not null, default: 0, note: '유효 플레이 누적 횟수']
  updated_at datetime(6) [not null, note: '수정 시각 UTC']
  created_at datetime(6) [not null, note: '사용자별 게임 통계 최초 생성 시각 UTC']

  indexes {
    (user_id, game_id) [unique, name: 'uq_user_game_stats_1']
  }

  checks {
    `best_score >= 0 AND valid_play_count >= 0` [name: 'chk_game_stats']
  }
}

Table draw_run_candidates {
  draw_run_id binary(16) [not null, note: '후보가 참여한 추첨 실행 ID. 최초 및 재추첨 실행']
  candidate_id binary(16) [not null, note: '재사용하는 최초 추첨 후보 ID']

  indexes {
    (draw_run_id, candidate_id) [pk]
  }

  Note: '실행별 포함 후보. 후보의 최초 이벤트와 실행 이벤트의 일치는 서비스에서 검증.'
}

Table missions {
  id binary(16) [pk, not null, note: '미션 ID']
  reward_policy_id binary(16) [not null, note: '적용 보상 정책 ID']
  created_by binary(16) [not null, note: '등록 관리자 ID']
  title varchar(200) [not null, note: '미션 제목']
  description text [not null, note: '상세 설명']
  mission_type missions_mission_type_enum [not null, note: 'SURVEY=설문 / QUIZ=퀴즈']
  starts_at datetime(6) [not null, note: '미션 운영 시작 시각 UTC']
  ends_at datetime(6) [not null, note: '미션 운영 종료 시각 UTC']
  status missions_status_enum [not null, note: 'ACTIVE=운영 중 / ENDED=종료']
  created_at datetime(6) [not null, note: '생성 시각 UTC']
  updated_at datetime(6) [not null, note: '수정 시각 UTC']
  image_key varchar(500) [note: '미션 설명 이미지 한 개의 저장소 경로']

  checks {
    `ends_at > starts_at` [name: 'chk_mission_dates']
  }
}

Table award_cancellations {
  id binary(16) [pk, not null, note: '당첨 취소 ID']
  draw_result_id binary(16) [not null, note: '취소한 SELECTED 추첨 결과 ID']
  draw_run_id binary(16) [note: '취소 저장 시 NULL, 재추첨 등록 시 설정 후 변경·해제 금지. 여러 취소가 같은 실행 참조 가능']
  canceled_by binary(16) [not null, note: '당첨 취소를 확정한 관리자 ID']
  reason text [not null, note: '당첨 취소 사유']
  canceled_at datetime(6) [not null, note: '당첨 취소 확정 시각 UTC']
  request_key binary(16) [note: '신규 AD05 요청의 전역 UUID 멱등 키. 과거 이력은 NULL']

  indexes {
    draw_result_id [unique, name: 'uq_award_cancellations_1']
    request_key [unique, name: 'uq_award_cancellations_request']
  }
}

Table survey_answers {
  id binary(16) [pk, not null, note: '설문 응답 ID']
  submission_id binary(16) [not null, note: '최종 제출 ID']
  mission_id binary(16) [not null, note: '제출과 문항의 소속 미션']
  survey_question_id binary(16) [not null, note: '설문 문항 ID']
  selected_option_id binary(16) [note: '단일 선택 답변']
  answer_text text [note: '자유 입력 답변']
  created_at datetime(6) [not null, note: '응답 저장 시각 UTC']

  indexes {
    (submission_id, survey_question_id) [unique, name: 'uq_survey_answers_1']
  }
}

Table draw_candidates {
  id binary(16) [pk, not null, note: '최초 추첨 후보 ID. 재추첨에서도 같은 후보 정보를 재사용']
  participant_id binary(16) [not null, note: '원본 이벤트 응모자 관계 ID']
  draw_run_id binary(16) [not null, note: '최초 후보 정보를 고정한 추첨 실행 ID. 재추첨 참여 실행은 draw_run_candidates에 연결']
  ticket_count bigint [not null, note: '해당 이벤트에서 접수 완료된 응모의 실제 누적 차감 수량. 재추첨은 최초 추첨 당시 값']
  weight bigint [not null, note: '해당 응모자의 추첨 가중치. 현재 선형 가중치 정책의 정수 값. 추가 배율 없음.']
  entry_snapshot json [not null, note: '확정 응모 근거 스냅샷. 응모 ID·실제 장수·접수 시각·등급별 사용량·적용 가중치. 재추첨 시 최초 값 유지']
  eligibility_snapshot json [not null, note: '후보 확정 당시 사용자·멤버십·역할·시각 스냅샷. 기존 excluded 필드는 호환용으로 유지하며 새 후보는 false. 과거 스냅샷은 소급 변경하지 않음.']
  created_at datetime(6) [not null, note: '후보 스냅샷 생성 시각 UTC']

  indexes {
    (draw_run_id, participant_id) [unique, name: 'uq_draw_candidates_1']
  }

  Note: '최초 후보 정보는 재사용. 이후 실행의 포함 후보는 draw_run_candidates에 보존. 최초 후보·가중치·근거는 확정 후 변경 금지.'

  checks {
    `ticket_count >= 0 AND weight >= 1` [name: 'chk_candidate_counts']
  }
}

Table event_participants {
  id binary(16) [pk, not null, note: '이벤트 응모자 ID']
  event_id binary(16) [not null, note: '연결 이벤트 ID']
  user_id binary(16) [not null, note: '사용자 ID']
  created_at datetime(6) [not null, note: '최초 응모 접수 완료·행 생성 시각 UTC']
  used_ticket_count bigint [not null, default: 0, note: '사용자별 이벤트 누적 차감 응모권 수']

  indexes {
    (event_id, user_id) [unique, name: 'uq_event_participants_1']
    (id, event_id, user_id) [unique, name: 'uq_event_participants_2']
    (id, user_id) [unique, name: 'uq_event_participants_3']
  }

  Note: '정상 접수된 이벤트·사용자별 응모자와 실제 누적 차감 장수를 보관한다. 지급 전 차단 기록을 이유로 정상 응모자를 추첨에서 제외하지 않으며 제외 상태·사유·시각의 대체 컬럼을 추가하지 않는다.'

  checks {
    `used_ticket_count >= 0` [name: 'chk_participant_used']
  }
}

Table users {
  id binary(16) [pk, not null, note: '사용자 ID']
  name varchar(20) [not null, note: '사용자 이름']
  role users_role_enum [not null, note: 'USER=일반 사용자 / ADMIN=관리자']
  status users_status_enum [not null, note: 'ACTIVE=활성 / INACTIVE=비활성']
  membership users_membership_enum [note: 'EXCELLENT=우수 / VIP=VIP / VVIP=VVIP']
  phone_num varchar(11) [note: '핸드폰 번호']
  email varchar(255) [note: '이메일']
  updated_at datetime(6) [not null, note: '수정 시각 UTC']
  created_at datetime(6) [not null, note: '생성 시각 UTC']
  suspended_at datetime(6) [note: '사용자 정지 시작 시각 UTC']
  suspension_reason text [note: '사용자 정지 사유']

  indexes {
    (created_at, id) [name: 'ix_users_created_id', note: 'V034: 두 컬럼 DESC, 관리자 최신순 목록']
    (role, status) [name: 'ix_users_role_status', note: 'V034: 활성 일반 사용자 집계']
    email [unique, name: 'uq_users_1']
    phone_num [unique, name: 'uq_users_2']
  }
}

Table draw_failures {
  id binary(16) [pk, not null, note: '같은 실패 기록의 저장 재시도에는 같은 ID 사용']
  draw_run_id binary(16) [not null, note: '동일 실행의 여러 실패를 연결']
  failure_code varchar(50) [not null, note: '실패 분류 코드. 원문 예외 메시지나 개인정보를 저장하지 않음']
  failed_at datetime(6) [not null, note: 'UTC. 기록 저장 시각과 구분']
  trace_id varchar(100) [note: '선택적인 상세 진단 기록 연결 ID. 발급·검색 시스템 연동 전에는 NULL 가능']
  indexes {
    (draw_run_id, failed_at, id) [name: 'draw_failure_history_idx']
  }
}

Table reward_policies {
  id binary(16) [pk, not null, note: '보상 정책 ID']
  created_by binary(16) [not null, note: '등록 관리자 ID']
  reward_type reward_policies_reward_type_enum [not null, note: 'ATTENDANCE=출석 / MISSION=미션 / GAME=게임']
  game_id binary(16) [note: 'GAME 정책일 때 필수']
  reward_ticket_count int [not null, note: '보상으로 지급할 응모권 수']
  effective_from datetime(6) [not null, note: '정책 적용 시작 시각 UTC']
  effective_until datetime(6) [note: '정책 적용 종료 시각 UTC']
  created_at datetime(6) [not null, note: '생성 시각 UTC']
  open_guard binary(16) [note: 'MySQL VIRTUAL 생성 컬럼. 종료일 없는 ATTENDANCE는 16바이트 0, GAME은 game_id, 그 외 NULL. 직접 입력 금지']
  reward_ticket_type reward_policies_reward_ticket_type_enum [note: '보상 등급 설정의 역할은 보완 필요. 출석 BRONZE 고정, 게임·미션은 무작위 지급이므로 고정 결과로 해석하지 않음']

  indexes {
    (reward_type, open_guard) [unique, name: 'uq_reward_policies_1']
    (game_id, effective_from) [unique, name: 'uq_game_policy_effective_from']
    (reward_type, effective_from) [name: 'reward_policy_effective_idx']
  }
  // GENERATED open_guard: CASE WHEN effective_until IS NULL AND reward_type = 'ATTENDANCE' THEN UNHEX(REPEAT('00', 16)) WHEN effective_until IS NULL AND reward_type = 'GAME' THEN game_id ELSE NULL END

  Note: 'open_guard 생성식은 동반 SQL에 구현. 범위별 정책 기간의 겹침은 UNIQUE만으로 보장되지 않음. reward_ticket_type 역할은 별도 확인.'

  checks {
    `(reward_type = 'GAME' AND game_id IS NOT NULL) OR (reward_type <> 'GAME' AND game_id IS NULL)` [name: 'chk_reward_policy_game']
    `effective_until IS NULL OR effective_until > effective_from` [name: 'chk_reward_policy_period']
    `reward_ticket_count >= 1` [name: 'chk_reward_policy_quantity']
    `(reward_type = 'ATTENDANCE' AND reward_ticket_count >= 1) OR (reward_type IN ('MISSION','GAME') AND reward_ticket_count = 1)` [name: 'chk_reward_current_quantity']
  }
}

Table audit_logs {
  id binary(16) [pk, not null, note: '운영 감사 로그 ID']
  actor_id binary(16) [note: '처리자 사용자 ID']
  action varchar(60) [not null, note: '감사 대상 작업 코드']
  target_type varchar(60) [not null, note: '감사 대상 테이블 또는 업무 객체 종류']
  target_id binary(16) [not null, note: '감사 대상 객체 UUID']
  reason text [note: '처리 사유']
  before_data json [note: '변경 전 데이터']
  after_data json [note: '변경 후 데이터']
  request_id varchar(100) [note: '관련 HTTP 요청 추적 ID']
  created_at datetime(6) [not null, note: '생성 시각 UTC']

  indexes {
    (target_type, target_id, created_at) [name: 'audit_target_time_idx']
  }
}

Table game_reward_claims {
  id binary(16) [pk, not null, note: '게임 보상 지급 ID']
  user_id binary(16) [not null, note: '보상 대상 사용자 ID']
  game_id binary(16) [not null, note: '보상 대상 게임 ID']
  game_play_id binary(16) [not null, note: '유효 플레이 ID']
  reward_policy_id binary(16) [not null, note: '적용 정책 ID']
  reward_date date [not null, note: '게임별 일일 보상 기준 날짜 KST']
  source_key varchar(160) [not null, note: '게임과 KST 날짜로 식별. 같은 플레이 재제출·정책 변경에도 새 보상 건으로 만들지 않음']
  ticket_count int [not null, note: '보상 수량']
  created_at datetime(6) [not null, note: '생성 시각 UTC']

  indexes {
    (id, user_id) [unique, name: 'uq_game_reward_claims_owner']
    game_play_id [unique, name: 'uq_game_reward_claims_play']
    (user_id, source_key) [unique, name: 'uq_game_reward_claims_1']
    (user_id, game_id, reward_date) [unique, name: 'uq_game_reward_claims_2']
  }

  Note: '같은 플레이의 보상 청구는 한 건이며, 사용자·게임·KST 보상일별 보상도 한 건. 중복 방지 키에 지급 등급이나 정책 ID를 추가하지 않음.'

  checks {
    `ticket_count = 1` [name: 'chk_game_claim_ticket']
  }
}

Table draw_checks {
  id binary(16) [pk, not null, note: '정합성 검증 기록 ID']
  draw_run_id binary(16) [not null, note: '검증한 확정 추첨 실행 ID']
  checked_by binary(16) [not null, note: '검증을 요청한 관리자 ID']
  passed boolean [not null, note: '전체 검증 통과 여부. true=통과, false=불통과']
  checks_snapshot json [not null, note: '항목별 정합성 검증 결과 스냅샷. 검증 버전·검증 범위·항목 코드·통과 여부·메시지.']
  checked_at datetime(6) [not null, note: '검증 완료·기록 시각 UTC']
}

Table attendance_streak_policy_sets {
  id binary(16) [pk, not null, note: '연속 출석 정책 묶음 ID']
  created_by binary(16) [not null, note: '등록 관리자 ID']
  effective_month date [not null, note: '적용 시작월의 1일 KST']
  created_at datetime(6) [not null, note: '생성 시각 UTC']

  indexes {
    effective_month [unique, name: 'uq_streak_policy_effective_month']
  }
}

Table notifications {
  id binary(16) [pk, not null, note: '개인 알림 ID']
  job_id binary(16) [not null, note: '알림 생성 작업 ID']
  user_id binary(16) [not null, note: '사용자 ID']
  event_id binary(16) [note: '연결 이벤트 ID']
  title varchar(200) [not null, note: '알림 제목']
  body text [not null, note: '알림 본문']
  link_url varchar(500) [note: '알림 선택 시 이동 URL']
  created_at datetime(6) [not null, note: '생성 시각 UTC']
  is_read boolean [not null, default: 0, note: '읽음 여부']
  mock_delivery_status notifications_mock_delivery_status_enum [not null, note: 'PENDING=발송 대기']
  mock_sent_at datetime(6) [note: '모의 발송 완료 시각 UTC']
  delivery_attempt_count int [not null, default: 0, note: '모의 발송 누적 선점 차수']
  delivery_attempt_base int [not null, default: 0, note: '현재 수동 발송 복구 구간의 시작 선점 차수']
  next_delivery_attempt_at datetime(6) [note: '다음 모의 발송 재시도 예정 시각 UTC']
  last_delivery_error text [note: '마지막 모의 발송 오류 내용']

  indexes {
    (job_id, user_id) [unique, name: 'uq_notification_job_user']
  }

  checks {
    `delivery_attempt_count >= 0` [name: 'chk_delivery_attempts']
    `delivery_attempt_base >= 0 AND delivery_attempt_base <= delivery_attempt_count` [name: 'chk_delivery_attempt_base']
  }
}

Table mission_quiz_questions {
  id binary(16) [pk, not null, note: '퀴즈 문항 ID']
  mission_id binary(16) [not null, note: '퀴즈 미션 ID']
  question_type mission_quiz_questions_question_type_enum [not null, note: 'OX / 단일 선택 / 단답형']
  question_text text [not null, note: '문제 내용']
  display_order int [not null, note: '문항 표시 순서']
  created_at datetime(6) [not null, note: '생성 시각 UTC']
  correct_answer text [note: '단답형 정답 하나']

  indexes {
    (mission_id, display_order) [unique, name: 'uq_mission_quiz_questions_1']
    (id, mission_id) [unique, name: 'uq_mission_quiz_questions_2']
  }

  checks {
    `(question_type = 'SHORT_ANSWER' AND correct_answer IS NOT NULL) OR (question_type <> 'SHORT_ANSWER' AND correct_answer IS NULL)` [name: 'chk_quiz_correct_answer']
  }
}

Table mission_reward_claims {
  id binary(16) [pk, not null, note: '미션 보상 지급 ID']
  reward_policy_id binary(16) [not null, note: '적용 미션 보상 정책 ID']
  mission_id binary(16) [not null, note: '완료 미션 ID']
  mission_submission_id binary(16) [not null, note: '최종 완료 근거 제출 ID']
  user_id binary(16) [not null, note: '보상 대상 사용자 ID']
  source_key varchar(160) [not null, note: '사용자별 미션 보상 식별 키']
  ticket_count int [not null, note: '실제 지급 수량']
  created_at datetime(6) [not null, note: '보상 지급 이력 생성 시각 UTC']

  indexes {
    (id, user_id) [unique, name: 'uq_mission_reward_claims_owner']
    (user_id, mission_id) [unique, name: 'uq_mission_reward_claims_1']
  }

  checks {
    `ticket_count = 1` [name: 'chk_mission_claim_ticket']
  }
}

Table quiz_answers {
  id binary(16) [pk, not null, note: '문항 답변 및 채점 기록 ID']
  submission_id binary(16) [not null, note: '제출 요청 ID']
  quiz_question_id binary(16) [not null, note: '응답 문항 ID']
  selected_option_id binary(16) [note: 'OX 및 단일 선택에서 필수, 단답형은 NULL']
  mission_id binary(16) [not null, note: '제출과 문항의 소속 미션']
  answer_text text [note: '단답형 입력, 선택형은 NULL']
  is_correct boolean [not null, note: '서버 채점 결과']
  created_at datetime(6) [not null, note: '생성 시각 UTC']

  indexes {
    (submission_id, quiz_question_id) [unique, name: 'uq_quiz_answers_1']
  }

  checks {
    `selected_option_id IS NOT NULL OR answer_text IS NOT NULL` [name: 'chk_quiz_answer_shape']
  }
}

Table survey_questions {
  id binary(16) [pk, not null, note: '설문 문항 ID']
  mission_id binary(16) [not null, note: '설문 미션 ID']
  question_type survey_questions_question_type_enum [not null, note: '단일 선택 또는 자유 입력']
  question_text text [not null, note: '질문 내용']
  is_required boolean [not null, note: '필수 응답 여부']
  display_order int [not null, note: '문항 순서']
  created_at datetime(6) [not null, note: '생성 시각 UTC']
  updated_at datetime(6) [not null, note: '마지막 수정 시각 UTC']

  indexes {
    (mission_id, display_order) [unique, name: 'uq_survey_questions_1']
    (id, mission_id) [unique, name: 'uq_survey_questions_2']
  }
}

Table survey_question_options {
  id binary(16) [pk, not null, note: '설문 선택지 ID']
  survey_question_id binary(16) [not null, note: '단일 선택 설문 문항 ID']
  option_text text [not null, note: '선택지 내용']
  display_order int [not null, note: '선택지 순서']
  created_at datetime(6) [not null, note: '생성 시각 UTC']

  indexes {
    (survey_question_id, display_order) [unique, name: 'uq_survey_question_options_1']
    (id, survey_question_id) [unique, name: 'uq_survey_question_options_2']
  }
}

Table attendance_reward_claims {
  id binary(16) [pk, not null, note: '출석 보상 지급 ID']
  attendance_id binary(16) [not null, note: '보상 근거 출석 기록 ID']
  reward_policy_id binary(16) [note: 'DAILY일 때 필수']
  attendance_streak_policy_id binary(16) [note: 'STREAK일 때 필수']
  user_id binary(16) [not null, note: '보상 대상 사용자 ID']
  reward_type attendance_reward_claims_reward_type_enum [not null, note: 'DAILY=기본 / STREAK=연속 출석']
  reward_date date [not null, note: '보상 기준 날짜 KST']
  milestone_days int [note: '연속 출석 달성 단계 일수']
  source_key varchar(160) [not null, note: '사용자·종류별 고정 업무 키. DAILY YYYY-MM-DD, STREAK YYYY-MM:단계일수. 정책 변경·재시도에도 유지']
  ticket_count int [not null, note: '실제 지급 수량']
  created_at datetime(6) [not null, note: '생성 시각 UTC']

  indexes {
    (id, user_id) [unique, name: 'uq_attendance_reward_claims_owner']
    (user_id, reward_type, source_key) [unique, name: 'uq_attendance_reward_claims_1']
  }

  Note: 'source_key는 DAILY 날짜, STREAK 월·단계의 고정 형식. 정책 ID를 키에 섞어 같은 업무 건을 재지급하지 않음. 출석 수량과 티켓 생성 장수는 같은 트랜잭션에서 검증.'

  checks {
    `(reward_type = 'DAILY' AND reward_policy_id IS NOT NULL AND attendance_streak_policy_id IS NULL AND milestone_days IS NULL) OR (reward_type = 'STREAK' AND attendance_streak_policy_id IS NOT NULL AND milestone_days IS NOT NULL AND reward_policy_id IS NULL)` [name: 'chk_attendance_claim_shape']
    `ticket_count >= 1` [name: 'chk_attendance_claim_ticket']
    `milestone_days IS NULL OR milestone_days BETWEEN 1 AND 28` [name: 'chk_attendance_milestone']
  }
}

Table attendance_streak_policies {
  id binary(16) [pk, not null, note: '연속 출석 단계 정책 ID']
  policy_set_id binary(16) [not null, note: '소속 정책 묶음 ID']
  milestone_days int [not null, note: '연속 출석 기준 일수 1~28']
  reward_ticket_count int [not null, note: '단계 달성 시 지급 수량']
  created_at datetime(6) [not null, note: '생성 시각 UTC']

  indexes {
    (policy_set_id, milestone_days) [unique, name: 'uq_streak_policy_milestone']
  }

  checks {
    `milestone_days BETWEEN 1 AND 28` [name: 'chk_streak_policy_milestone']
    `reward_ticket_count >= 1` [name: 'chk_streak_policy_reward']
  }
}

Table notification_jobs {
  id binary(16) [pk, not null, note: '알림 생성 작업 ID']
  event_id binary(16) [note: '연결 이벤트 ID']
  source_job_id binary(16) [note: '일정 변경 및 취소 시 기존 시작 알림 수신자를 찾는 원본 작업 ID']
  payload json [not null, note: '알림 내용과 최초 생성 시점의 대상 스냅샷']
  occurrence_key varchar(160) [not null, note: '작업별 고정 발생 키']
  notification_type notification_jobs_notification_type_enum [not null, note: '시작·최초 발표·제외·일정 변경·취소·결과 변경. 실제 업무 확정에 연결해 발생 키 고정']
  status notification_jobs_status_enum [not null, note: 'PENDING=대기']
  last_processed_user_id binary(16) [note: '고정 대상 집합에서 UUID 바이트 순으로 마지막 처리한 사용자 ID']
  attempt_count int [not null, default: 0, note: '작업 실행 누적 선점 차수']
  attempt_base int [not null, default: 0, note: '현재 수동 복구 구간의 시작 선점 차수']
  scheduled_at datetime(6) [not null, note: '알림 생성 예정 시각 UTC']
  next_attempt_at datetime(6) [note: '다음 재시도 예정 시각 UTC']
  lease_until datetime(6) [note: '작업 처리권 임대 만료 시각 UTC']
  last_error text [note: '마지막 작업 오류 내용']
  created_at datetime(6) [not null, note: '생성 시각 UTC']
  completed_at datetime(6) [note: '완료 시각 UTC']

  indexes {
    occurrence_key [unique, name: 'uq_notification_job_occurrence']
    (scheduled_at, id) [name: 'ix_notification_job_schedule']
  }

  checks {
    `attempt_count >= 0` [name: 'chk_notification_attempts']
    `attempt_base >= 0 AND attempt_base <= attempt_count` [name: 'chk_notification_attempt_base']
  }
}

Table quiz_question_options {
  id binary(16) [pk, not null, note: '퀴즈 선택지 ID']
  quiz_question_id binary(16) [not null, note: '퀴즈 문항 ID']
  option_text text [not null, note: '선택지 내용']
  display_order int [not null, note: '선택지 순서']
  is_correct boolean [not null, note: '정답 여부']
  created_at datetime(6) [not null, note: '생성 시각 UTC']

  indexes {
    (quiz_question_id, display_order) [unique, name: 'uq_quiz_question_options_1']
    (id, quiz_question_id) [unique, name: 'uq_quiz_question_options_2']
  }
}

Table draw_results {
  id binary(16) [pk, not null, note: 'SELECTED 결과의 ID가 API의 winId']
  draw_run_id binary(16) [not null, note: '결과를 생성한 추첨 실행 ID']
  event_prize_id binary(16) [not null, note: '선정 또는 미충원된 이벤트 경품 ID']
  slot_number int [not null, note: '경품별 당첨 자리 번호. 1부터 해당 경품 당첨 인원까지']
  result_type draw_results_result_type_enum [not null, note: '결과 종류. SELECTED=당첨자 선정, UNFILLED=후보 부족으로 미충원']
  candidate_id binary(16) [note: '선정된 추첨 대상자 ID. UNFILLED는 NULL']
  selection_order int [note: '실행 내 실제 당첨 선정 순서. 상위 등수부터 선정하며 UNFILLED는 NULL']
  created_at datetime(6) [not null, note: '선정·미충원 결과 기록 시각 UTC']

  indexes {
    (id, draw_run_id) [unique, name: 'uq_draw_results_run']
    (draw_run_id, event_prize_id, slot_number) [unique, name: 'uq_draw_results_1']
    (draw_run_id, candidate_id) [unique, name: 'uq_draw_results_2']
    (draw_run_id, selection_order) [unique, name: 'uq_draw_results_3']
  }

  Note: '실행 후보 소속은 복합 FK로 보장. 경품·후보·실행의 이벤트 일치와 유지 당첨자를 포함한 실행 간 중복 당첨은 추가 검증.'

  checks {
    `(result_type = 'UNFILLED' AND candidate_id IS NULL AND selection_order IS NULL) OR (result_type = 'SELECTED' AND candidate_id IS NOT NULL AND selection_order IS NOT NULL)` [name: 'chk_draw_result_shape']
    `slot_number >= 1` [name: 'chk_draw_slot']
    `selection_order IS NULL OR selection_order >= 1` [name: 'chk_draw_selection_order']
  }
}

Table draw_runs {
  id binary(16) [pk, not null, note: '추첨 실행 ID']
  event_id binary(16) [not null, note: '추첨 대상 이벤트 ID']
  run_number int [not null, note: '이벤트별 추첨 차수. 이벤트별 최초 0, 새 재추첨마다 증가. 실패 재시도는 유지.']
  draw_type draw_runs_draw_type_enum [not null, note: '추첨 종류. INITIAL=최초 추첨, REPLACEMENT=당첨 취소에 따른 재추첨']
  status draw_runs_status_enum [not null, note: '실행 상태. PREPARING=준비 중, READY=후보·조건 확정, RUNNING=실행 중, CONFIRMED=결과 확정, FAILED=실패, NO_ENTRIES=응모자 없음, NO_CANDIDATES=과거 전원 제외 이력 호환용. GD-130 이후 신규 생성하지 않음']
  algorithm_version varchar(100) [note: 'READY 이후 필수·불변.']
  rules_snapshot json [note: 'READY 이후 필수·불변. 경품·자리·가중치 기준·유지 당첨 결과 ID·대상 자리.']
  snapshot_fixed_at datetime(6) [note: 'UTC. 확정 전 NULL']
  started_at datetime(6) [note: 'UTC. 시작 전 NULL']
  confirmed_at datetime(6) [note: 'UTC. 확정 전 NULL']
  created_at datetime(6) [not null, note: '추첨 실행 및 작업 등록 시각 UTC']
  // GD-87 V019 구현안. 운영 DB 적용·실행 검증 전.
  attempt_id binary(16) [note: '진행 중 시도 ID. 같은 실패 저장의 멱등 ID로 재사용']
  lease_until datetime(6) [note: 'UTC. 시도 소유권 만료. 이벤트 잠금 아래 복구 여부 재확인']
  retry_at datetime(6) [note: 'UTC. FAILED에서 NULL이면 운영자 대기, 값이 있으면 자동 재시도 예약']
  retry_cycle_started_at datetime(6) [note: 'UTC. 재개 후 자동 재시도 구간 경계. 횟수는 실패 이력에서 조회']

  indexes {
    (id, event_id) [unique, name: 'uq_draw_runs_event']
    (event_id, run_number) [unique, name: 'uq_draw_runs_1']
    (status, retry_at) [name: 'draw_retry_due_idx']
    (status, lease_until) [name: 'draw_lease_due_idx']
  }

  checks {
    `(draw_type = 'INITIAL' AND run_number = 0) OR (draw_type = 'REPLACEMENT' AND run_number >= 1)` [name: 'chk_draw_number']
    `status NOT IN ('READY','RUNNING','CONFIRMED') OR (algorithm_version IS NOT NULL AND rules_snapshot IS NOT NULL AND snapshot_fixed_at IS NOT NULL)` [name: 'chk_draw_fixed_input']
    `status NOT IN ('NO_ENTRIES','NO_CANDIDATES') OR (algorithm_version IS NOT NULL AND rules_snapshot IS NOT NULL AND snapshot_fixed_at IS NOT NULL)` [name: 'chk_draw_empty_fixed_input']
    `status <> 'CONFIRMED' OR confirmed_at IS NOT NULL` [name: 'chk_draw_confirmed_time']
    `(attempt_id IS NULL AND lease_until IS NULL) OR (attempt_id IS NOT NULL AND lease_until IS NOT NULL AND retry_cycle_started_at IS NOT NULL AND status IN ('PREPARING','READY','RUNNING'))` [name: 'chk_draw_attempt']
    `retry_at IS NULL OR (status = 'FAILED' AND attempt_id IS NULL AND retry_cycle_started_at IS NOT NULL)` [name: 'chk_draw_retry']
  }
}

Table mission_submissions {
  id binary(16) [pk, not null, note: '미션 제출 ID']
  mission_id binary(16) [not null, note: '미션 ID']
  reward_policy_id binary(16) [not null, note: '적용 보상 정책 ID']
  user_id binary(16) [not null, note: '사용자 ID']
  is_completed boolean [not null, note: 'true=완료 / false=미완료']
  created_at datetime(6) [not null, note: '생성 시각 UTC']

  indexes {
    (id, mission_id) [unique, name: 'uq_mission_submissions_2']
  }

  Note: '사용자·미션 UNIQUE를 추가하지 않음: 오답 재도전 제출 여러 행 허용. 삭제된 수신 시각·요청 멱등 키의 대체 보장은 별도 확인.'
}

Table games {
  id binary(16) [pk, not null, note: '게임 ID']
  code varchar(50) [not null, note: '게임 구분 코드']
  name varchar(100) [not null, note: '게임명']
  description text [note: '상세 설명']
  rules json [not null, note: '게임 규칙']
  rule_version varchar(30) [not null, note: '적용 게임 규칙 버전']
  is_active boolean [not null, default: 1, note: 'true=활성 / false=비활성']
  created_at datetime(6) [not null, note: '생성 시각 UTC']
  updated_at datetime(6) [not null, note: '수정 시각 UTC']

  indexes {
    code [unique, name: 'uq_games_1']
  }
}

Table quiz_question_progress {
  id binary(16) [pk, not null, note: '문항 정답 진행 ID']
  quiz_question_id binary(16) [not null, note: '정답으로 완료한 퀴즈 문항 ID']
  correct_answer_id binary(16) [not null, note: '정답 판정의 근거 답변 ID']
  user_id binary(16) [not null, note: '사용자 ID']
  created_at datetime(6) [not null, note: '생성 시각 UTC']

  indexes {
    (user_id, quiz_question_id) [unique, name: 'uq_quiz_question_progress_1']
  }
}

Table draw_publications {
  id binary(16) [pk, not null, note: '공개 명단 버전 ID']
  event_id binary(16) [not null, note: '명단을 공개한 이벤트 ID']
  source_draw_id binary(16) [not null, note: '이번 공개·갱신의 원인이 된 추첨 실행 ID. 명단에는 이전 실행 결과도 포함 가능']
  revision int [not null, note: '이벤트별 공개 명단 버전 번호. 최초 1, 갱신마다 증가']
  publication_type draw_publications_publication_type_enum [not null, note: '공개 종류. INITIAL=최초 자동 공개, UPDATE=관리자 확인 후 명단 갱신']
  reason text [note: '공개 명단 변경 사유. UPDATE는 필수. 정상 최초 자동 공개는 NULL 가능']
  confirmed_by binary(16) [note: '공개 버전의 관리자 최종 확인·발표 처리자. GD-199 신규 최초 공개도 기록. 과거 INITIAL의 NULL은 보존. 실행별 원래 확인은 draw_result_confirmations에서 보존']
  confirmed_at datetime(6) [note: '공개 버전의 관리자 최종 확인 시각 UTC. GD-199 최초 발표 요청에서 공개와 함께 기록. 과거 INITIAL의 NULL은 보존']
  published_at datetime(6) [not null, note: '해당 명단 버전을 실제 공개에 반영한 시각 UTC']

  indexes {
    (id, event_id) [unique, name: 'uq_draw_publications_event']
    (event_id, revision) [unique, name: 'uq_draw_publications_1']
  }

  Note: 'source_draw_id는 공개 계기. 실제 포함 결과는 버전별 불변 보존. GD-199는 관리자 단일 발표 요청에서 최초·재추첨의 필요한 확인과 전체 명단을 함께 저장. 자동 추첨은 자동 공개가 아님. 공개 버전·재시도·명단 변경 검사는 이벤트 잠금과 같은 트랜잭션으로 보장.'

  checks {
    `(publication_type = 'INITIAL' AND revision = 1) OR (publication_type = 'UPDATE' AND revision >= 2)` [name: 'chk_publication_type_revision']
    `revision >= 1` [name: 'chk_publication_revision']
    `(confirmed_by IS NULL AND confirmed_at IS NULL) OR (confirmed_by IS NOT NULL AND confirmed_at IS NOT NULL)` [name: 'chk_publication_confirmation_pair']
    `publication_type <> 'UPDATE' OR (confirmed_by IS NOT NULL AND confirmed_at IS NOT NULL AND reason IS NOT NULL AND TRIM(reason) <> '')` [name: 'chk_publication_update']
  }
}

Table event_prizes {
  id binary(16) [pk, not null, note: '이벤트 경품 ID']
  event_id binary(16) [not null, note: '연결 이벤트 ID']
  prize_rank int [not null, note: '경품 등수']
  name varchar(200) [not null, note: '경품명']
  description text [note: '상세 설명']
  winner_count int [not null, note: '당첨 인원']
  created_at datetime(6) [not null, note: '생성 시각 UTC']
  updated_at datetime(6) [not null, note: '수정 시각 UTC']
  image_key varchar(500) [note: '경품 이미지 저장소 경로']

  indexes {
    (event_id, prize_rank) [unique, name: 'uq_event_prizes_1']
  }

  checks {
    `prize_rank >= 1` [name: 'chk_event_prize_rank']
    `winner_count > 0` [name: 'chk_event_prize_winner_count']
  }
}

Table attendance_streaks {
  id binary(16) [pk, not null, note: '월별 연속 출석 상태 ID']
  user_id binary(16) [not null, note: '사용자 ID']
  policy_set_id binary(16) [not null, note: '해당 월에 적용한 연속 출석 정책 묶음 ID']
  streak_month date [not null, note: 'KST 기준 출석 기준월의 1일']
  consecutive_days int [not null, note: '마지막 출석일까지 이어진 연속 출석 일수']
  last_attendance_date date [not null, note: '마지막 출석 인정 날짜 KST']
  created_at datetime(6) [not null, note: '생성 시각 UTC']
  updated_at datetime(6) [not null, note: '연속 출석 상태 갱신 시각 UTC']

  indexes {
    (user_id, streak_month) [unique, name: 'uq_attendance_streaks_1']
  }

  checks {
    `consecutive_days BETWEEN 0 AND 31` [name: 'chk_streak_days']
  }
}

Table event_entries {
  id binary(16) [pk, not null, note: '클라이언트가 최초 요청 전에 발급한 응모 UUID. 같은 응모 재시도는 동일 ID, 새로운 추가 응모는 새 ID 사용. PK로 중복 저장 방지']
  participant_id binary(16) [not null, note: '접수 완료된 응모의 이벤트 참여자 ID']
  user_id binary(16) [not null, note: '사용자 ID']
  requested_ticket_count int [not null, note: '요청한 응모권 차감 수량']
  deducted_ticket_count int [not null, default: 0, note: '실제 차감 응모권 수량']
  created_at datetime(6) [not null, note: '접수 완료된 응모의 처리 결과 기록 시각 UTC. 접수 성립·마감 판정은 차감과 함께 트랜잭션 확정 기준']

  Note: '성공 응모의 개별 기록. 같은 ID 재시도는 사용자·이벤트·요청 수량 일치를 확인하고 기존 결과를 반환하며 추가 차감하지 않음. 1회 제한 이벤트의 새 응모는 event_participants의 (event_id, user_id) UNIQUE에 따라 참가자 신규 생성에 성공한 요청만 저장. 참가자 생성·응모 저장·필요한 응모권 차감과 이력은 같은 트랜잭션으로 처리하며 참가자 중복 충돌 후 새 응모를 계속 저장하지 않음. 추가 응모는 기존 참가자를 사용하고 누적 상한을 참가자 행 잠금 등으로 검증. 응모 UUID 전달 API 계약과 실제 서비스 구현은 후속 반영 필요.'

  checks {
    `requested_ticket_count >= 0` [name: 'chk_entry_requested']
    `deducted_ticket_count >= 0` [name: 'chk_entry_deducted']
  }
}

Table banners {
  id binary(16) [pk, not null, note: '배너 ID']
  event_id binary(16) [note: '연결 이벤트. 이전 URL 행은 관리자 연결 전 NULL']
  image_key varchar(500) [not null, note: '이미지 저장소 경로']
  display_order int [not null, note: '서비스 전체 노출 순서 1~5']
  created_at datetime(6) [not null, note: '생성 시각 UTC']
  updated_at datetime(6) [not null, note: '수정 시각 UTC']
  event_url varchar(500) [note: '이벤트 URL']

  indexes {
    display_order [unique, name: 'uq_banners_1']
    event_id [name: 'idx_banners_event_id']
  }

  Note: 'V028 이벤트 연결. 기존 URL·행 보존. 미연결/삭제/취소 배너는 사용자에게 숨기고 관리자에게 유지. CHECK·UNIQUE로 최대 5개.'

  checks {
    `display_order BETWEEN 1 AND 5` [name: 'chk_banner_order']
  }
}

Table banner_catalog_lock {
  id tinyint [pk, not null, note: '고정 제어 행 1. 빈 목록에서도 카탈로그 쓰기 직렬화']
  checks {
    `id = 1` [name: 'chk_banner_catalog_lock']
  }
}

Table abuse_cases {
  id binary(16) [pk, not null, note: '차단 이력 ID. 최초 ID를 재시도에도 유지']
  event_id binary(16) [note: '확인된 관련 이벤트. 미확인은 NULL']
  user_id binary(16) [not null, note: '사용자 ID']
  attendance_id binary(16) [note: '기존 FK 보존. ENTRY에서는 NULL']
  mission_submission_id binary(16) [note: '기존 FK 보존. ENTRY에서는 NULL']
  game_play_id binary(16) [note: '기존 FK 보존. ENTRY에서는 NULL']
  source_type varchar(40) [not null, note: '요청 기능. 현재 ENTRY']
  detection_type varchar(50) [not null, note: 'ENTRY는 REPEATED_RATE_LIMIT_EXCEEDED']
  detection_reason text [not null, note: '서버가 생성한 고정 차단 사유']
  evidence json [not null, note: '최초 차단 당시 관측값·설정값. 목록에는 비노출']
  occurred_at datetime(6) [not null, note: '임계값 도달 요청의 서버 수신 시각 UTC']
  detected_at datetime(6) [not null, note: '최초 Redis 판정 시각 UTC. blocked_at과 동일']
  blocked_at datetime(6) [not null, note: '최초 차단 시작 시각 UTC']
  blocked_until datetime(6) [not null, note: '최초 차단 종료 예정 시각 UTC']

  indexes {
    (user_id, source_type, blocked_at) [unique, name: 'uq_abuse_user_source_blocked']
    (blocked_at, id) [name: 'idx_abuse_blocked']
    (user_id, blocked_at, id) [name: 'idx_abuse_user_blocked']
  }

  Note: 'V030: 빈 테이블에서만 전환. 차단마다 행을 추가하며 만료로 수정하지 않음. 정상 응모의 추첨 제외에 사용하지 않음.'

  checks {
    `(attendance_id IS NOT NULL) + (mission_submission_id IS NOT NULL) + (game_play_id IS NOT NULL) <= 1` [name: 'chk_abuse_one_source']
    `blocked_until > blocked_at` [name: 'chk_abuse_block_period']
    `source_type <> 'ENTRY' OR (attendance_id IS NULL AND mission_submission_id IS NULL AND game_play_id IS NULL)` [name: 'chk_abuse_entry_sources']
    `source_type <> 'ENTRY' OR (BINARY detection_type = BINARY 'REPEATED_RATE_LIMIT_EXCEEDED' AND BINARY detection_reason = BINARY '응모 요청 한도 초과가 반복되어 일시 차단되었습니다.')` [name: 'chk_abuse_entry_detection']
  }
}

Table events {
  id binary(16) [pk, not null, note: '이벤트 ID']
  title varchar(200) [not null, note: '이벤트 제목']
  description text [not null, note: '상세 설명']
  image_key varchar(500) [note: '이미지 저장소 경로']
  detail_image_key varchar(500) [default: null, note: '이벤트 상세 설명 이미지의 S3 저장 키']
  event_type events_event_type_enum [not null, note: 'NO_TICKET=응모권 미사용 / TICKET=응모권 사용']
  weighting_enabled boolean [not null, default: 0, note: '추첨 가중치 적용 여부']
  max_tickets_per_user int [note: '사용자별 이벤트 누적 상한']
  starts_at datetime(6) [not null, note: '응모 시작 시각 UTC']
  ends_at datetime(6) [not null, note: '응모 마감 시각 UTC']
  status events_status_enum [not null, note: '이벤트 상태']
  canceled_at datetime(6) [note: '취소 시각 UTC']
  created_at datetime(6) [not null, note: '생성 시각 UTC']
  updated_at datetime(6) [not null, note: '수정 시각 UTC']
  deleted_at datetime(6) [note: '논리 삭제 시각 UTC']
  membership_rule events_membership_rule_enum [not null, note: 'excellent=우수 / vip=VIP / vvip=VVIP']

  indexes {
    (status, deleted_at, starts_at, id) [name: 'idx_events_lifecycle_start']
    (status, deleted_at, ends_at, id) [name: 'idx_events_lifecycle_end']
  }

  checks {
    `max_tickets_per_user IS NULL OR max_tickets_per_user > 0` [name: 'chk_event_ticket_limit']
    `ends_at > starts_at` [name: 'chk_event_dates']
  }
}

Table game_log_batches {
  id binary(16) [pk, not null, note: '로그 묶음 ID. 같은 묶음 재전송 시 동일 ID 유지']
  game_play_id binary(16) [not null, note: '원본 게임 플레이 ID']
  payload_hash char(64) [not null, note: '서버가 계산한 원본 내용 SHA-256']
  event_count int [not null, note: '묶음에 포함된 행동 이벤트 수']
  first_sequence_no bigint [not null, note: '묶음 내 최소 행동 순번']
  last_sequence_no bigint [not null, note: '묶음 내 최대 행동 순번']
  s3_bucket varchar(63) [not null, note: '원본을 저장할 S3 버킷']
  s3_object_key varchar(1024) [not null, note: '원본 객체 키. 경로 기록만으로 저장 완료를 의미하지 않음']
  storage_status game_log_batches_storage_status_enum [not null, default: 'PENDING', note: '원본 저장 대기 / 저장 완료 / 저장 실패']
  last_error_code varchar(100) [note: '최근 원본 저장 실패 사유 코드']
  received_at datetime(6) [not null, note: 'API 최초 수신 시각 UTC']
  stored_at datetime(6) [note: 'S3 저장 성공 확인 시각 UTC']
  created_at datetime(6) [not null, note: 'DB 기록 생성 시각 UTC']
  updated_at datetime(6) [not null, note: '최근 상태 변경 시각 UTC']

  checks {
    `event_count > 0 AND first_sequence_no <= last_sequence_no` [name: 'chk_batch_count']
    `(storage_status = 'STORED' AND stored_at IS NOT NULL) OR (storage_status <> 'STORED' AND stored_at IS NULL)` [name: 'chk_batch_storage']
  }
}

Table game_play_analyses {
  id binary(16) [pk, not null, note: '플레이 분석 ID']
  game_play_id binary(16) [not null, note: '분석 대상 게임 플레이 ID']
  analyzer_version varchar(50) [not null, note: '분석 로직과 규칙 및 설정을 식별하는 버전']
  input_hash char(64) [not null, note: '정규화한 분석 입력 목록과 수집 종료 정보의 SHA-256']
  input_manifest json [not null, note: '분석한 batchId와 payloadHash 목록 및 기대 최종 순번 등 입력 스냅샷']
  status game_play_analyses_status_enum [not null, default: 'PENDING', note: '분석 작업 대기 / 처리 중 / 완료 / 실패']
  data_completeness game_play_analyses_data_completeness_enum [not null, default: 'UNKNOWN', note: '로그 수집 완전성. 어뷰징 판정과 별개']
  verdict game_play_analyses_verdict_enum [note: '정상 / 어뷰징. 분석 전과 실패 시 NULL']
  event_count int [note: '중복 제거 후 분석한 행동 이벤트 수']
  duplicate_event_count int [note: '분석 입력에서 확인한 중복 이벤트 수']
  missing_sequence_count bigint [note: '누락 순번 수. 최종 범위를 모르면 NULL']
  metrics json [note: '클릭 수와 입력 간격 및 반복 패턴 등 분석 지표']
  detection_reasons json [note: '자동 판정 근거. 규칙 코드와 관측값 및 기준값']
  last_error_code varchar(100) [note: '최근 분석 작업 실패 사유 코드']
  started_at datetime(6) [note: '최근 분석 시도 시작 시각 UTC']
  completed_at datetime(6) [note: '분석 성공 완료 시각 UTC']
  created_at datetime(6) [not null, note: '분석 작업 생성 시각 UTC']
  updated_at datetime(6) [not null, note: '최근 상태 변경 시각 UTC']

  indexes {
    (game_play_id, analyzer_version, input_hash) [unique, name: 'uq_game_play_analyses_input']
  }

  checks {
    `(status = 'COMPLETED' AND verdict IS NOT NULL AND completed_at IS NOT NULL) OR (status <> 'COMPLETED' AND verdict IS NULL AND completed_at IS NULL)` [name: 'chk_analysis_result']
    `(event_count IS NULL OR event_count >= 0) AND (duplicate_event_count IS NULL OR duplicate_event_count >= 0) AND (missing_sequence_count IS NULL OR missing_sequence_count >= 0)` [name: 'chk_analysis_counts']
  }
}

Table tickets {
  id binary(16) [pk, not null, note: '응모권 한 장 ID. 반환과 재사용 후에도 유지']
  user_id binary(16) [not null, note: '소유 사용자 ID. 최초 확정 후 변경 금지']
  attendance_reward_claim_id binary(16) [note: '최초 출석 지급 근거 ID. 다른 보상 종류이면 NULL. 같은 청구로 여러 장 지급 가능. 확정 후 변경 금지']
  mission_reward_claim_id binary(16) [note: '최초 미션 지급 근거 ID. 다른 보상 종류이면 NULL. 청구당 티켓 1장. 확정 후 변경 금지']
  game_reward_claim_id binary(16) [note: '최초 게임 지급 근거 ID. 다른 보상 종류이면 NULL. 청구당 티켓 1장. 확정 후 변경 금지']
  grade tickets_grade_enum [not null, note: '최초 지급 등급. 출석 BRONZE 고정, 게임·미션은 최초 확정한 무작위 등급. 이후 불변. 기존 무등급 응모권은 없다고 가정하며 있다면 일괄 BRONZE로 전환']
  status tickets_status_enum [not null, note: '현재 상태. 최초 사용 가능 / 반환 후 사용 가능 / 사용됨 / 만료 처리됨']
  expires_at datetime(6) [not null, note: '현재 만료 시각 UTC. 반환 성공 시 갱신']
  version bigint [not null, default: 1, note: '현재 변경 순번. 최초 지급 1, 변경마다 1 증가. 마지막 이력 버전과 일치']
  created_at datetime(6) [not null, note: '최초 지급 시각 UTC. 변경 금지']
  updated_at datetime(6) [not null, note: '최근 업무 처리 시각 UTC. 현재값 갱신과 함께 반영']

  indexes {
    mission_reward_claim_id [unique, name: 'uq_tickets_1']
    game_reward_claim_id [unique, name: 'uq_tickets_2']
  }

  Note: '현재 상태와 최초 지급 근거. 출석은 설정 수량만큼 브론즈 여러 장을 지급할 수 있으므로 출석 청구 ID에는 UNIQUE를 두지 않음. 미션·게임은 청구당 한 장 UNIQUE를 유지. 등급은 NOT NULL이며 출석 등급 CHECK는 SILVER/GOLD를 거절한다. 현재값·소유자·등급 불변과 티켓 이력 일치는 서비스 트랜잭션에서 보장. 반환·정정 원본은 ticket_histories에서 연결.'

  checks {
    `(attendance_reward_claim_id IS NOT NULL) + (mission_reward_claim_id IS NOT NULL) + (game_reward_claim_id IS NOT NULL) = 1` [name: 'chk_ticket_source']
    `attendance_reward_claim_id IS NULL OR grade = 'BRONZE'` [name: 'chk_ticket_attendance_bronze']
    `version >= 1` [name: 'chk_ticket_version']
    `updated_at >= created_at` [name: 'chk_ticket_times']
  }
}

Table ticket_histories {
  id binary(16) [pk, not null, note: '응모권 한 장의 처리 이력 ID. 확정 후 수정·삭제 없이 보존']
  ticket_id binary(16) [not null, note: '처리 대상 응모권 ID. 한 티켓에 여러 버전의 이력이 누적됨']
  original_use_history_id binary(16) [note: 'REFUND의 원본 USE 이력 ID. 동일 사용 이력은 한 번만 반환. 다른 유형 NULL']
  corrected_history_id binary(16) [note: 'CORRECTION의 정정 대상 이력 ID. 같은 티켓의 과거 기록. 다른 유형 NULL. 원본 수정 없이 새 이력 추가']
  event_entry_id binary(16) [note: 'USE 개별 응모 ID. 한 응모에 여러 티켓 사용 가능. 다른 처리 NULL']
  operation_type ticket_histories_operation_type_enum [not null, note: '지급 / 사용 / 반환 / 만료 / 정정. 반환·정정은 해당 원본 이력에 연결']
  ticket_version bigint [not null, note: '처리 후 티켓 버전. 최초 GRANT 1, 이후 1씩 증가하는 이력 순서']
  status ticket_histories_status_enum [not null, note: '처리 결과 상태. 해당 버전 처리 완료 당시 값이며 이후 변경하지 않음']
  expires_at datetime(6) [not null, note: '처리 결과 만료 시각 UTC. 해당 버전 완료 당시 값이며 이후 변경하지 않음']
  reason text [not null, note: '처리 사유. 원문 예외·개인정보·비밀값 저장 금지']
  created_at datetime(6) [not null, note: '실제 처리 시각 UTC. 반환 만료 계산의 기준']

  indexes {
    (id, ticket_id) [unique, name: 'uq_ticket_histories_ticket']
    original_use_history_id [unique, name: 'uq_ticket_histories_refund_source']
    (ticket_id, ticket_version) [unique, name: 'uq_ticket_histories_1']
    (event_entry_id, ticket_id) [unique, name: 'uq_ticket_histories_2']
  }

  Note: '처리 결과 스냅샷을 버전별로 추가. 수정·삭제 금지. UNIQUE는 버전 중복을 막으며 버전 연속성·상태 전이·현재값 일치·원본 유형·과거 버전·상태 전이를 모두 보장하지 않음. 반환 원본은 USE여야 하며 정정 대상은 같은 티켓의 과거 버전이어야 함. 원본 버전이 새 버전보다 작은지 검증하여 자기 참조·순환 연결을 차단. 사용자 일치와 현재값·이력 추가는 같은 트랜잭션에서 보장.'

  checks {
    `(operation_type = 'REFUND' AND original_use_history_id IS NOT NULL) OR (operation_type <> 'REFUND' AND original_use_history_id IS NULL)` [name: 'chk_history_refund_source']
    `(operation_type = 'CORRECTION' AND corrected_history_id IS NOT NULL) OR (operation_type <> 'CORRECTION' AND corrected_history_id IS NULL)` [name: 'chk_history_correction_source']
    `original_use_history_id IS NULL OR original_use_history_id <> id` [name: 'chk_history_no_self_refund']
    `corrected_history_id IS NULL OR corrected_history_id <> id` [name: 'chk_history_no_self_correction']
    `(operation_type = 'GRANT' AND ticket_version = 1) OR (operation_type <> 'GRANT' AND ticket_version >= 2)` [name: 'chk_history_version']
    `(operation_type = 'USE' AND event_entry_id IS NOT NULL) OR (operation_type <> 'USE' AND event_entry_id IS NULL)` [name: 'chk_history_entry']
    `(operation_type = 'GRANT' AND status = 'AVAILABLE') OR (operation_type = 'USE' AND status = 'SPENT') OR (operation_type = 'REFUND' AND status = 'RETURNED') OR (operation_type = 'EXPIRE' AND status = 'EXPIRED') OR operation_type = 'CORRECTION'` [name: 'chk_history_state']
  }
}

// 근거: getddo-spec/02-domain/drawing.md 결과 발표 및 pending-decisions.md API·저장 후속.
Table draw_result_confirmations {
  id binary(16) [pk, not null, note: '재추첨 결과의 관리자 확인 이력 ID. 확정 후 수정·삭제 금지']
  draw_run_id binary(16) [not null, note: '관리자가 최종 확인한 INITIAL·REPLACEMENT 실행 ID. GD-199 최초 발표 요청에서 필요한 확인을 함께 기록']
  confirmed_by binary(16) [not null, note: '실제 확인 관리자 ID']
  confirmed_at datetime(6) [not null, note: '관리자 확인 시각 UTC. 실행 결과 확정 시각 및 실제 공개 시각과 구분']

  indexes {
    draw_run_id [unique, name: 'uq_draw_result_confirmations_run']
    (id, draw_run_id) [unique, name: 'uq_draw_result_confirmations_id_run']
  }
  Note: '확정된 최초·재추첨 결과의 최종 확인 성공 이력. 기존 확인은 수정·삭제하지 않고 재사용. CONFIRMED·관리자 권한·결과 불변을 서비스에서 검증. GD-199 최초 발표는 별도 확인 요청 없이 공개와 함께 저장. 취소 사유는 연결된 award_cancellations에서 조회.'
}

Table draw_publication_executions {
  publication_id binary(16) [not null, note: '실제 공개 버전 ID']
  draw_run_id binary(16) [not null, note: '미충원을 포함해 명단에 반영된 INITIAL·REPLACEMENT 실행 ID']
  event_id binary(16) [not null, note: '공개 버전과 실행의 이벤트 일치']
  confirmation_id binary(16) [not null, note: '실행별 불변 관리자 확인 근거']
  indexes {
    (publication_id, draw_run_id) [pk]
  }
  Note: 'V024 신규 테이블. 미충원으로 SELECTED 포함 행이 없는 실행의 확인 근거도 보존. 과거 버전의 누락 근거를 현재 상태로 추정해 채우지 않는다.'
}

Table draw_publication_results {
  publication_id binary(16) [not null, note: '실제 공개 명단 버전 ID']
  draw_result_id binary(16) [not null, note: '이 버전에 실제 포함한 SELECTED 결과 ID. 이전 실행 유지 결과와 새 재추첨 결과 모두 포함']
  event_id binary(16) [not null, note: '공개 버전과 결과 실행의 이벤트 일치를 복합 FK로 보장']
  draw_run_id binary(16) [not null, note: '포함 결과의 원본 실행 ID. 공개 계기 실행과 다를 수 있음']
  confirmation_id binary(16) [note: '실행별 관리자 최종 확인 이력. GD-199 신규 최초 공개는 INITIAL도 연결. 과거 INITIAL의 NULL은 보존. 유지 결과는 기존 확인 재사용']

  indexes {
    (publication_id, draw_result_id) [pk, name: 'pk_draw_publication_results']
  }
  Note: '공개 버전의 전체 명단을 같은 트랜잭션에서 고정하고 수정·삭제하지 않음. GD-199 신규 최초 공개는 INITIAL·REPLACEMENT의 최종 확인을 연결하며 과거 INITIAL의 NULL은 소급 변경하지 않음. SELECTED, 확인 시각 <= 공개 시각, 이벤트 일치, 취소 제외·유지 결과 포함, 중복 사용자·자리를 검증. 빈 명단도 공개 버전으로 보존. 사유·처리자·변경 전후는 원본 이력으로 조회.'
}

